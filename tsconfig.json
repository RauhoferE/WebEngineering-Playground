{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler", // Vite does the actual transpiling
    "strict": true,
    "noUncheckedIndexedAccess": true, // Elements of array can be undefined
    "noImplicitReturns": true,
    "isolatedModules": true, // Transpile files in isolation for ts patterns that dont survive this
    "skipLibCheck": true,
    "noEmit": true // Vite does the actual transpiling
  },
  "include": ["js"]
}
